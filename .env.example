# Skillet .env example — copy to .env and edit values
# Never commit your real .env.

# Postgres (used by docker-compose and to build the API's DATABASE_URL)
POSTGRES_USER=skillet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=skillet
POSTGRES_PORT=5432        # host-side bind only; the container always listens on 5432

# Host ports
APP_PORT=8000             # API container host bind
WEB_PORT=3000             # frontend (web) container host bind, used with --profile web

# API behaviour (optional)
COOKIE_SECURE=false       # set true when serving the API over HTTPS
# COOKIE_NAME=skillet-session
# LOGIN_RATE_LIMIT=5/minute
# UPLOAD_DIR=./uploads      # relative to the API container's /app
# MAX_UPLOAD_SIZE=5242880   # bytes (5 MiB)
# SECRET_KEY=change-me      # reserved; not currently consumed

# Origins allowed to call the API from the browser (comma-separated).
# With the single-origin setup (recommended) this is the public site origin, e.g.
# CORS_ORIGINS=https://skillet.example.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Browser-reachable API origin, inlined into the frontend bundle at BUILD time.
# - Dev (api + postgres only): http://localhost:${APP_PORT:-8000}
# - Self-host, single origin: the public site origin (its /api path is proxied
#   to the API container), e.g. https://skillet.example.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional explicit database URL; otherwise docker-compose constructs one
# DATABASE_URL=postgresql+asyncpg://skillet:change-me@postgres:5432/skillet