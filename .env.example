# Skillet .env example — copy to .env and edit values

# App
APP_PORT=8000

# Postgres
POSTGRES_USER=skillet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=skillet
POSTGRES_PORT=5432

# Secrets
# A strong secret used for JWT or any other signing. Replace in production.
JWT_SECRET=replace-this-with-a-secure-random-string

# Optional: explicit DATABASE_URL is supported, otherwise docker-compose constructs one
# DATABASE_URL=postgresql://skillet:change-me@postgres:5432/skillet
